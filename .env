# ─────────────────────────────────────────
# DATABASE - OLTP & SDM (Sekarang Postgres)
# ─────────────────────────────────────────
# Password utama untuk semua Postgres (biar simpel)
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=warehouse_secret

# Koneksi ke DB Akademik (Port internal 5432, tapi luar 5433)
DB_AKADEMIK_HOST=datains_oltp
DB_AKADEMIK_PORT=5432
DB_AKADEMIK_DB=db_akademik

# Koneksi ke DB SDM (Port internal 5432, tapi luar 5434)
DB_SDM_HOST=datains_sdm
DB_SDM_PORT=5432
DB_SDM_DB=db_sdm

# ─────────────────────────────────────────
# DATABASE - WAREHOUSE (PostgreSQL)
# ─────────────────────────────────────────
DB_WAREHOUSE_HOST=datains_warehouse
DB_WAREHOUSE_PORT=5432
DB_WAREHOUSE_DB=db_warehouse

# ─────────────────────────────────────────
# BACKEND (FastAPI)
# ─────────────────────────────────────────
SECRET_KEY=ganti-ini-pake-string-random-yang-panjang
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8088"]

# ─────────────────────────────────────────
# FRONTEND (Next.js)
# ─────────────────────────────────────────
# Kalau lewat Nginx, biasanya cukup /api/v1
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_SUPERSET_URL=http://localhost:8088

# ─────────────────────────────────────────
# SUPERSET & N8N
# ─────────────────────────────────────────
SUPERSET_SECRET_KEY=bikin-random-aja-yang-penting-rahasia
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin123

N8N_USER=admin
N8N_PASSWORD=admin123

# ─────────────────────────────────────────
# AI / LLM (GROQ / OPENAI)
# ─────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
OPENAI_API_KEY=sk-your-key-here