# ==========================================
# DATAINS CAPSTONE - ENVIRONMENT VARIABLES EXAMPLE
# Copy file ini menjadi `.env` sebelum menjalankan aplikasi
# ==========================================

# ------------------------------------------
# 1. DATABASE CONFIGURATION (POSTGRESQL & SUPABASE)
# ------------------------------------------
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=your_postgres_password_here

# Local OLTP & SDM Databases
DB_AKADEMIK_HOST=datains_oltp
DB_AKADEMIK_PORT=5432
DB_AKADEMIK_DB=db_akademik

DB_SDM_HOST=datains_sdm
DB_SDM_PORT=5432
DB_SDM_DB=db_sdm

# Production Data Warehouse (Supabase Cloud / PostgreSQL)
DB_WAREHOUSE_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_WAREHOUSE_PORT=6543
DB_WAREHOUSE_DB=postgres
DB_WAREHOUSE_USER=postgres.zuooajizxhtsxswdwcha
DB_WAREHOUSE_PASSWORD=your_supabase_db_password
DB_WAREHOUSE_SSL=true

# ------------------------------------------
# 2. BACKEND & SECURITY (FASTAPI)
# ------------------------------------------
SECRET_KEY=your_random_secret_key_here_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (JSON Array String)
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:3005","https://eduinsight.windsight.id","https://api-eduinsight.windsight.id"]

# ------------------------------------------
# 3. FRONTEND CONFIGURATION (REACT)
# ------------------------------------------
REACT_APP_API_URL=https://api-eduinsight.windsight.id/api/v1
REACT_APP_SUPABASE_URL=https://zuooajizxhtsxswdwcha.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here
REACT_APP_SUPERSET_URL=https://dash.varguard.id

# ------------------------------------------
# 4. APACHE SUPERSET (BI DASHBOARD)
# ------------------------------------------
SUPERSET_SECRET_KEY=your_superset_secret_key_here
SUPERSET_URL=https://dash.varguard.id
SUPERSET_ADMIN_USER=admin@domain.com
SUPERSET_ADMIN_PASSWORD=your_superset_admin_password
SUPERSET_DATABASE_URI=postgresql://postgres.zuooajizxhtsxswdwcha:your_password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------
# 5. N8N & AI AGENT WORKFLOWS
# ------------------------------------------
N8N_USER=admin
N8N_PASSWORD=your_n8n_password
OPENAI_API_KEY=sk-your-openai-api-key-here
GROQ_API_KEY=gsk_your_groq_api_key_here
